rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Blogs Collection ──────────────────────────────────────────────────
    // Public read (for homepage/blog pages). Write open for admin operations.
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if true;
    }

    // ─── Categories Collection ─────────────────────────────────────────────
    // Public read (for category pills on public pages).
    // Write open for admin dashboard (create, edit, delete, reorder).
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // ─── Settings Collection ───────────────────────────────────────────────
    // Public read for about page. Write open for admin.
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

  }
}
